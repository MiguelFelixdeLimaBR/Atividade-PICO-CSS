<form action = '/cadastrar/diretores' method = 'POST'>

    <label>Nome</label>
    <input type = 'text' name = 'nome'>

    <label>Ano de Nascimento</label>
    <input type = 'text' name = 'anoNascimento'>

    <label>Está em Atividade?</label>
    
    <select name="atv">
        <option value="Sim">Sim</option>
        <option value="Não">Não</option>
    </select>

    <button type="button" onclick="modal.showModal()">
    Salvar
  </button>
</form>

<dialog id="modal">
  <article>

    <header>
      <strong>Confirmar cadastro</strong>
    </header>

    <p>Deseja realmente cadastrar este filme?</p>

    <button
      type="button"
      class="secondary"
      onclick="modal.close()">
      Cancelar
    </button>

    <button
      type="button"
      onclick="formFilme.submit()">
      Confirmar
    </button>

  </article>
</dialog>

