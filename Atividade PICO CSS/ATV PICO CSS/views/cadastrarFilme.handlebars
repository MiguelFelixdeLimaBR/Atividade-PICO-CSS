<h1>Cadastrar Filme</h1>

<form id="formFilme" action="/filmes" method="POST">

  <label>
    Nome:
    <input type="text" name="nome" required>
  </label>

  <label>
    Ano:
    <input type="number" name="ano" required>
  </label>

  <label>
    Diretor:
    <select name="diretorId" required>
      <option value="">Selecione um diretor</option>
      {{#each diretores}}
        <option value="{{id}}">{{nome}}</option>
      {{/each}}
    </select>
  </label>

  <label>
    Artistas:
    <select name="artistas" multiple>
      {{#each artistas}}
        <option value="{{id}}">{{nome}}</option>
      {{/each}}
    </select>
  </label>

  <button type="button" onclick="modal.showModal()">
    Salvar
  </button>

</form>

<dialog id="modal">
  <article>

    <header>
      <strong>Confirmar cadastro</strong>
    </header>

    <p>Deseja realmente cadastrar este filme?</p>

    <button
      type="button"
      class="secondary"
      onclick="modal.close()">
      Cancelar
    </button>

    <button
      type="button"
      onclick="formFilme.submit()">
      Confirmar
    </button>

  </article>
</dialog>
