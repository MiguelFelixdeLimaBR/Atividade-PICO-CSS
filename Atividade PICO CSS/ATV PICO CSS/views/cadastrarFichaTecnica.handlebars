<h1>Ficha Técnica - {{filme.nome}}</h1>

<form action="/filmes/{{filme.id}}/ficha-tecnica" method="POST">

  <div>
    <label>Duração (minutos):</label>
    <input type="number" name="duracaoMinutos">
  </div>

  <br>

  <div>
    <label>Orçamento:</label>
    <input type="number" step="0.01" name="orcamento">
  </div>

  <br>

  <div>
    <label>Bilheteria:</label>
    <input type="number" step="0.01" name="bilheteria">
  </div>

  <br>

<button type="button" onclick="modal.showModal()">
    Salvar
  </button>

</form>

<dialog id="modal">
  <article>

    <header>
      <strong>Confirmar cadastro</strong>
    </header>

    <p>Deseja realmente cadastrar este filme?</p>

    <button
      type="button"
      class="secondary"
      onclick="modal.close()">
      Cancelar
    </button>

    <button
      type="button"
      onclick="formFilme.submit()">
      Confirmar
    </button>

  </article>
</dialog>
