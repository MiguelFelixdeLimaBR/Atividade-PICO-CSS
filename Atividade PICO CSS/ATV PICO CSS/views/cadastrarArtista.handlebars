<h1>Cadastrar Artista</h1>

<form action="/artistas" method="POST">

  <div>
    <label>Nome:</label>
    <input type="text" name="nome">
  </div>

  <br>

  <div>
    <label>Ano de nascimento:</label>
    <input type="number" name="anoNascimento">
  </div>

  <br>

  <div>
    <label>Nome artístico:</label>
    <input type="text" name="nomeArtistico">
  </div>

  <br>

  <button type="button" onclick="modal.showModal()">
    Salvar
  </button>

</form>

<dialog id="modal">
  <article>

    <header>
      <strong>Confirmar cadastro</strong>
    </header>

    <p>Deseja realmente cadastrar este filme?</p>

    <button
      type="button"
      class="secondary"
      onclick="modal.close()">
      Cancelar
    </button>

    <button
      type="button"
      onclick="formFilme.submit()">
      Confirmar
    </button>

  </article>
</dialog>
